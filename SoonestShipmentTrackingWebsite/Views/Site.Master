<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SoonestShipmentTrackingWebsite.Views.Site" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Soonest Global Express Corporation</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="<%= ResolveUrl("~/Views/Theme.css") %>" />
</head>
<body>
<form id="mainForm" runat="server">
    <header class="site-header">
        <div class="container">
            <a class="brand" runat="server" href="Default.aspx">
                <img class="brand-icon-img" src="<%= ResolveUrl("~/Assets/icons/logo.svg") %>" alt="Soonest Global Express" />
                <span class="brand-name">Soonest Global Express<span class="brand-sub">CORPORATION</span></span>
            </a>
        </div>
    </header>
    <nav class="navbar" id="siteNav">
        <div class="container">
            <ul class="nav-links">
                <li><a runat="server" href="Default.aspx">Home</a></li>
                <li><a runat="server" href="About.aspx">About</a></li>
                <li><a runat="server" href="Contact.aspx">Contact</a></li>
                <asp:PlaceHolder ID="pnlCustomerNav" runat="server" Visible="false">
                    <li><a runat="server" href="Customer/MyShipments.aspx">My Shipments</a></li>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="pnlStaffNav" runat="server" Visible="false">
                    <asp:PlaceHolder ID="pnlDashboardNav" runat="server" Visible="false">
                        <li><a runat="server" href="~/Views/Admin/Dashboard.aspx">Admin Dashboard</a></li>
                    </asp:PlaceHolder>
                    <li><a runat="server" href="~/Views/Admin/Shipments.aspx">Manage Shipments</a></li>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="pnlAdminNav" runat="server" Visible="false">
                    <li><a runat="server" href="~/Views/Admin/UserAccounts.aspx">Manage Staff</a></li>
                    <li><a runat="server" href="~/Views/Admin/Branches.aspx">Manage Branch</a></li>
                    <li><a runat="server" href="~/Views/Admin/Reports.aspx">Reports</a></li>
                </asp:PlaceHolder>
            </ul>
            <div class="nav-actions">
                <asp:PlaceHolder ID="pnlCustomerNotif" runat="server" Visible="false">
                    <div class="notif-wrap" id="notifWrap">
                        <button type="button" class="notif-bell" id="notifBell" aria-label="Notifications" aria-expanded="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                            <span class="notif-badge" id="notifBadge" runat="server"><asp:Literal ID="litNotifCount" runat="server" /></span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-head">Notifications</div>
                            <div class="notif-list">
                                <asp:Repeater ID="rptNotifications" runat="server">
                                    <ItemTemplate>
                                        <a class='notif-item <%# (bool)Eval("IsUnread") ? "unread" : "" %>' href='<%# ResolveUrl(Eval("NavigateUrl").ToString()) %>'>
                                            <span class="notif-dot"></span>
                                            <span class="notif-body">
                                                <span class="notif-msg"><%# Eval("Message") %></span>
                                                <span class="notif-meta"><%# Eval("TimeAgo") %></span>
                                            </span>
                                        </a>
                                    </ItemTemplate>
                                </asp:Repeater>
                                <asp:Label ID="lblNoNotif" runat="server" CssClass="notif-empty" Text="No shipment updates yet." Visible="false" />
                            </div>
                            <asp:HyperLink ID="lnkNotifViewAll" runat="server" CssClass="notif-viewall" Text="View all shipments" NavigateUrl="~/Views/Customer/MyShipments.aspx" />
                        </div>
                    </div>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="pnlLoggedIn" runat="server" Visible="false">
                    <span class="welcome-text">Signed in as <asp:Literal ID="litUserName" runat="server" /></span>
                    <asp:LinkButton ID="btnLogOff" runat="server" CssClass="btn btn-outline" OnClick="btnLogOff_Click">Log off</asp:LinkButton>
                </asp:PlaceHolder>
                <asp:PlaceHolder ID="pnlLoggedOut" runat="server">
                    <a runat="server" href="~/Views/Account/Login.aspx" class="btn btn-outline"><img class="btn-icon" src="<%= ResolveUrl("~/Assets/icons/user.svg") %>" alt="" />Login</a>
                    <a runat="server" href="~/Views/Account/Register.aspx" class="btn btn-red"><img class="btn-icon" src="<%= ResolveUrl("~/Assets/icons/user.svg") %>" alt="" />Sign Up</a>
                </asp:PlaceHolder>
            </div>
            <button type="button" class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false"><span></span><span></span><span></span></button>
        </div>
    </nav>
    <asp:Panel ID="pnlFlashMessage" runat="server" Visible="false">
        <div class="container" style="margin-top:18px;"><div class="alert-success"><asp:Literal ID="litFlashMessage" runat="server" /></div></div>
    </asp:Panel>
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    <footer class="site-footer">
        <div class="container"><div class="footer-grid">
            <div class="footer-brand">
                <a class="brand" runat="server" href="Default.aspx">
                    <img class="brand-icon-img" src="<%= ResolveUrl("~/Assets/icons/logo.svg") %>" alt="Soonest Global Express" />
                    <span class="brand-name">Soonest Global Express<span class="brand-sub">CORPORATION</span></span>
                </a>
                <p>Dependable local and international logistics with real-time tracking, secure handling, and people who care about every parcel.</p>
            </div>
            <div><h5>Get In Touch</h5><p>Las Pi&ntilde;as City (Main Office and Warehouse)<br />Jerusalem Street, BF Martinville Manuyo Dos,<br />Las Pi&ntilde;as City, Philippines</p><p>Tel: +632 249 8970<br />Email: info@soonestglobal.com</p></div>
            <div><h5>Quick Links</h5><ul><li><a runat="server" href="Default.aspx">Home</a></li><li><a runat="server" href="Track.aspx">Track Shipment</a></li><li><a runat="server" href="~/Views/Account/Register.aspx">Create Account</a></li><li><a runat="server" href="~/Views/Account/Login.aspx">Log In</a></li></ul></div>
            <div><h5>Services</h5><ul><li>International Freight</li><li>Domestic Delivery</li><li>Real-Time Tracking</li><li>Dedicated Support</li></ul></div>
        </div></div>
        <div class="footer-bottom">Soonest Global Express Corporation &copy; 2026. All rights reserved.</div>
    </footer>
</form>
<script type="text/javascript">
    (function () {
        var nav = document.getElementById('siteNav');
        var toggle = document.getElementById('navToggle');
        if (nav && toggle) {
            toggle.addEventListener('click', function () {
                var open = nav.className.indexOf('nav-open') !== -1;
                nav.className = open ? nav.className.replace(/\s*nav-open/g, '') : nav.className + ' nav-open';
                toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
            });
        }
        var path = (location.pathname || '').toLowerCase();
        var current = path.substring(path.lastIndexOf('/') + 1);
        if (current === '' || current === 'default') { current = 'default.aspx'; }
        var links = document.querySelectorAll('.nav-links a');
        for (var i = 0; i < links.length; i++) {
            var href = (links[i].getAttribute('href') || '').toLowerCase();
            var file = href.substring(href.lastIndexOf('/') + 1);
            if (file && file === current) {
                links[i].className += (links[i].className ? ' ' : '') + 'active';
            }
        }

        var wrap = document.getElementById('notifWrap');
        var bell = document.getElementById('notifBell');
        if (wrap && bell) {
            bell.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = wrap.className.indexOf('open') !== -1;
                wrap.className = open ? wrap.className.replace(/\s*open/g, '') : wrap.className + ' open';
                bell.setAttribute('aria-expanded', open ? 'false' : 'true');
            });
            document.addEventListener('click', function (e) {
                if (wrap.className.indexOf('open') !== -1 && !wrap.contains(e.target)) {
                    wrap.className = wrap.className.replace(/\s*open/g, '');
                    bell.setAttribute('aria-expanded', 'false');
                }
            });
        }
    })();
</script>
