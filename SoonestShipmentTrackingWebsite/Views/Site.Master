<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SoonestShipmentTrackingWebsite.Views.Site" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="description" content="Soonest Global Express Corporation - dependable local and international logistics with real-time shipment tracking." />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Soonest Global Express Corporation</asp:ContentPlaceHolder> | Soonest Global Express</title>
    <%-- The ?v= value is the file's last-write time, so browsers pick up CSS changes automatically. --%>
    <link rel="stylesheet" href="<%= ResolveUrl("~/Views/Theme.css") %>?v=<%= System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Views/Theme.css")).Ticks %>" />
    <link rel="icon" type="image/svg+xml" href="<%= ResolveUrl("~/Assets/icons/logo.svg") %>" />
</head>
<body>
<form id="mainForm" runat="server" class="site-layout">
    <a class="skip-link" href="#mainContent">Skip to main content</a>

    <%-- ========== Staff / admin / rider sidebar ========== --%>
    <asp:PlaceHolder ID="pnlAdminSidebar" runat="server" Visible="false">
        <aside class="admin-sidebar" id="adminSidebar" aria-label="Admin navigation">
            <a class="admin-sidebar-brand" href="<%= ResolveUrl("~/Views/Admin/Shipments.aspx") %>">
                <img class="brand-icon-img" src="<%= ResolveUrl("~/Assets/icons/logo.svg") %>" alt="" />
                <span class="brand-name">Soonest Admin</span>
            </a>
            <nav class="admin-sidebar-nav" aria-label="Admin">
                <div class="sidebar-heading">Operations</div>
                <asp:PlaceHolder ID="pnlSidebarDashboard" runat="server" Visible="false">
                    <a href="<%= ResolveUrl("~/Views/Admin/Dashboard.aspx") %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>Dashboard</a>
                </asp:PlaceHolder>
                <a href="<%= ResolveUrl("~/Views/Admin/Shipments.aspx") %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.3 7.5L12 12.5l8.7-5M12 22V12.5"/></svg>Manage Shipments</a>
                <asp:PlaceHolder ID="pnlSidebarAdminOnly" runat="server" Visible="false">
                    <div class="sidebar-heading">Administration</div>
                    <a href="<%= ResolveUrl("~/Views/Admin/UserAccounts.aspx") %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Manage Users</a>
                    <a href="<%= ResolveUrl("~/Views/Admin/Riders.aspx") %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>Manage Riders</a>
                    <a href="<%= ResolveUrl("~/Views/Admin/Branches.aspx") %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/></svg>Manage Branch</a>
                    <a href="<%= ResolveUrl("~/Views/Admin/Reports.aspx") %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15v3M12 9v9M17 5v13"/></svg>Reports</a>
                </asp:PlaceHolder>
            </nav>
            <div class="admin-sidebar-footer">
                <div class="admin-sidebar-user">
                    <span class="user-avatar" aria-hidden="true"></span>
                    <div class="user-meta">
                        <span class="user-label">Signed in as</span>
                        <span class="user-name"><asp:Literal ID="litSidebarUserName" runat="server" /></span>
                    </div>
                </div>
                <a runat="server" href="~/Views/Account/Profile.aspx" class="btn btn-outline btn-block btn-sm">My Profile</a>
                <asp:LinkButton ID="btnSidebarLogOff" runat="server" CssClass="btn btn-outline btn-block btn-sm" OnClick="btnLogOff_Click">Logout</asp:LinkButton>
            </div>
        </aside>
    </asp:PlaceHolder>
    <div class="shell-backdrop" id="shellBackdrop"></div>

    <div class="site-body">

        <%-- ========== Utility strip (public pages) ========== --%>
        <div class="topbar">
            <div class="container">
                <div class="topbar-info">
                    <span class="topbar-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Mon&ndash;Sat, 9:00 AM &ndash; 7:00 PM</span>
                    <a class="topbar-item" href="mailto:info@soonestglobal.com"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>info@soonestglobal.com</a>
                </div>
                <a runat="server" href="~/Views/Track.aspx">Track a shipment &rarr;</a>
            </div>
        </div>

        <%-- ========== Main navigation ========== --%>
        <header class="site-header">
            <nav class="navbar" id="siteNav" aria-label="Main">
                <div class="container">
                    <a class="brand" runat="server" href="~/Views/Default.aspx">
                        <img class="brand-icon-img" src="<%= ResolveUrl("~/Assets/icons/logo.svg") %>" alt="" />
                        <span class="brand-name">Soonest Global Express<span class="brand-sub">CORPORATION</span></span>
                    </a>
                    <ul class="nav-links">
                        <li><a runat="server" href="~/Views/Default.aspx">Home</a></li>
                        <li><a runat="server" href="~/Views/About.aspx">About</a></li>
                        <li><a runat="server" href="~/Views/Contact.aspx">Contact</a></li>
                        <asp:PlaceHolder ID="pnlCustomerNav" runat="server" Visible="false">
                            <li><a runat="server" href="~/Views/Customer/MyShipments.aspx">My Shipments</a></li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="pnlStaffNav" runat="server" Visible="false">
                            <asp:PlaceHolder ID="pnlDashboardNav" runat="server" Visible="false">
                                <li><a runat="server" href="~/Views/Admin/Dashboard.aspx">Admin Dashboard</a></li>
                            </asp:PlaceHolder>
                            <li><a runat="server" href="~/Views/Admin/Shipments.aspx">Manage Shipments</a></li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="pnlAdminNav" runat="server" Visible="false">
                            <li><a runat="server" href="~/Views/Admin/UserAccounts.aspx">Manage Users</a></li>
                            <li><a runat="server" href="~/Views/Admin/Riders.aspx">Manage Riders</a></li>
                            <li><a runat="server" href="~/Views/Admin/Branches.aspx">Manage Branch</a></li>
                            <li><a runat="server" href="~/Views/Admin/Reports.aspx">Reports</a></li>
                        </asp:PlaceHolder>
                    </ul>
                    <div class="nav-actions">
                        <asp:PlaceHolder ID="pnlCustomerNotif" runat="server" Visible="false">
                            <div class="notif-wrap" id="notifWrap">
                                <button type="button" class="notif-bell" id="notifBell" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                                    <span class="notif-badge" id="notifBadge" runat="server"><asp:Literal ID="litNotifCount" runat="server" /></span>
                                </button>
                                <div class="notif-dropdown" id="notifDropdown">
                                    <div class="notif-head">Notifications</div>
                                    <div class="notif-list">
                                        <asp:Repeater ID="rptNotifications" runat="server">
                                            <ItemTemplate>
                                                <a class='notif-item <%# (bool)Eval("IsUnread") ? "unread" : "" %>' href='<%# ResolveUrl(Eval("NavigateUrl").ToString()) %>'>
                                                    <span class="notif-dot"></span>
                                                    <span class="notif-body">
                                                        <span class="notif-msg"><%# Eval("Message") %></span>
                                                        <span class="notif-meta"><%# Eval("TimeAgo") %></span>
                                                    </span>
                                                </a>
                                            </ItemTemplate>
                                        </asp:Repeater>
                                        <asp:Label ID="lblNoNotif" runat="server" CssClass="notif-empty" Text="No shipment updates yet." Visible="false" />
                                    </div>
                                    <asp:HyperLink ID="lnkNotifViewAll" runat="server" CssClass="notif-viewall" Text="View all shipments" NavigateUrl="~/Views/Customer/MyShipments.aspx" />
                                </div>
                            </div>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="pnlLoggedIn" runat="server" Visible="false">
                            <span class="user-chip">
                                <span class="user-avatar" aria-hidden="true"></span>
                                <span class="user-name"><asp:Literal ID="litUserName" runat="server" /></span>
                            </span>
                            <a runat="server" href="~/Views/Account/Profile.aspx" class="btn btn-outline">Profile</a>
                            <asp:LinkButton ID="btnLogOff" runat="server" CssClass="btn btn-outline btn-logout" OnClick="btnLogOff_Click">Logout</asp:LinkButton>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="pnlLoggedOut" runat="server">
                            <a runat="server" href="~/Views/Account/Login.aspx" class="btn btn-outline">Log In</a>
                            <a runat="server" href="~/Views/Account/Register.aspx" class="btn btn-primary">Sign Up</a>
                        </asp:PlaceHolder>
                    </div>
                    <button type="button" class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false"><span></span><span></span><span></span></button>
                </div>
            </nav>
        </header>

        <asp:Panel ID="pnlFlashMessage" runat="server" Visible="false">
            <div class="container flash-wrap"><div class="alert-success" role="status"><asp:Literal ID="litFlashMessage" runat="server" /></div></div>
        </asp:Panel>

        <main class="site-main" id="mainContent">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="site-footer">
            <div class="container"><div class="footer-grid">
                <div class="footer-brand">
                    <a class="brand" runat="server" href="~/Views/Default.aspx">
                        <img class="brand-icon-img" src="<%= ResolveUrl("~/Assets/icons/logo.svg") %>" alt="" />
                        <span class="brand-name">Soonest Global Express<span class="brand-sub">CORPORATION</span></span>
                    </a>
                    <p>Dependable local and international logistics with real-time tracking, secure handling, and people who care about every parcel.</p>
                </div>
                <div>
                    <h5>Get In Touch</h5>
                    <p>Las Pi&ntilde;as City (Main Office and Warehouse)<br />Jerusalem Street, BF Martinville Manuyo Dos,<br />Las Pi&ntilde;as City, Philippines</p>
                    <p>Tel: +632 249 8970<br />Email: <a href="mailto:info@soonestglobal.com">info@soonestglobal.com</a></p>
                </div>
                <div>
                    <h5>Quick Links</h5>
                    <ul>
                        <li><a runat="server" href="~/Views/Default.aspx">Home</a></li>
                        <li><a runat="server" href="~/Views/About.aspx">About Us</a></li>
                        <li><a runat="server" href="~/Views/Track.aspx">Track Shipment</a></li>
                        <li><a runat="server" href="~/Views/Contact.aspx">Contact</a></li>
                        <li><a runat="server" href="~/Views/Account/Register.aspx">Create Account</a></li>
                        <li><a runat="server" href="~/Views/Account/Login.aspx">Log In</a></li>
                    </ul>
                </div>
                <div>
                    <h5>Services</h5>
                    <ul><li>International Freight</li><li>Domestic Delivery</li><li>Real-Time Tracking</li><li>Dedicated Support</li></ul>
                </div>
            </div></div>
            <div class="footer-bottom">Soonest Global Express Corporation &copy; <%= DateTime.Now.Year %>. All rights reserved.</div>
        </footer>
    </div>
</form>
<script type="text/javascript">
    (function () {
        var form = document.getElementById('mainForm');
        var nav = document.getElementById('siteNav');
        var toggle = document.getElementById('navToggle');
        var isShell = !!form && form.classList.contains('admin-shell-mode');

        // Mobile menu: slide-in sidebar for staff/admin, dropdown for everyone else
        function setMenu(open) {
            if (isShell) { form.classList.toggle('shell-open', open); }
            else if (nav) { nav.classList.toggle('nav-open', open); }
            if (toggle) { toggle.setAttribute('aria-expanded', open ? 'true' : 'false'); }
        }
        if (toggle) {
            toggle.addEventListener('click', function () {
                setMenu(!(isShell ? form.classList.contains('shell-open') : nav.classList.contains('nav-open')));
            });
        }
        var backdrop = document.getElementById('shellBackdrop');
        if (backdrop) { backdrop.addEventListener('click', function () { setMenu(false); }); }

        // Highlight the current page. Child pages highlight their parent menu item.
        var parents = {
            'updatestatus.aspx': 'shipments.aspx', 'createshipment.aspx': 'shipments.aspx',
            'rideredit.aspx': 'riders.aspx', 'branchedit.aspx': 'branches.aspx',
            'userroleedit.aspx': 'useraccounts.aspx',
            'shipmentdetails.aspx': 'myshipments.aspx', 'requestshipment.aspx': 'myshipments.aspx'
        };
        var path = (location.pathname || '').toLowerCase();
        var current = path.substring(path.lastIndexOf('/') + 1);
        if (current === '' || current === 'default') { current = 'default.aspx'; }
        if (parents[current]) { current = parents[current]; }
        var links = document.querySelectorAll('.nav-links a, .admin-sidebar-nav a');
        for (var i = 0; i < links.length; i++) {
            var href = (links[i].getAttribute('href') || '').toLowerCase().split('?')[0];
            var file = href.substring(href.lastIndexOf('/') + 1);
            if (file && file === current) {
                links[i].classList.add('active');
                links[i].setAttribute('aria-current', 'page');
            }
        }

        // Avatar initials from the signed-in name / email
        var avatars = document.querySelectorAll('.user-avatar');
        for (var a = 0; a < avatars.length; a++) {
            var holder = avatars[a].parentNode;
            var nameEl = holder ? holder.querySelector('.user-name') : null;
            var text = nameEl ? nameEl.textContent.trim() : '';
            var local = text.split('@')[0];
            var parts = local.split(/[\s._-]+/).filter(Boolean);
            avatars[a].textContent = parts.length > 1 ? parts[0].charAt(0) + parts[1].charAt(0) : (local.substring(0, 2) || '?');
        }

        // Notification dropdown
        var wrap = document.getElementById('notifWrap');
        var bell = document.getElementById('notifBell');
        function closeNotif() {
            if (wrap && wrap.classList.contains('open')) {
                wrap.classList.remove('open');
                bell.setAttribute('aria-expanded', 'false');
            }
        }
        if (wrap && bell) {
            bell.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = wrap.classList.toggle('open');
                bell.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) {
                if (e.target instanceof Node && !wrap.contains(e.target)) { closeNotif(); }
            });
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { closeNotif(); setMenu(false); }
        });
    })();
</script>
</body>
</html>
